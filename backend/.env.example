PORT=5500
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Supabase Credentials (Project Settings -> API)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

# Spotify Application Credentials (https://developer.spotify.com)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:5500/api/spotify/callback

# Security & Fingerprint Hashing
FINGERPRINT_SALT=your_random_secret_salt_here